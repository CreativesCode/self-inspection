# ===========================================
# SELF INSPECTION SYSTEM - ENVIRONMENT VARIABLES
# ===========================================
# Copia este archivo como .env y actualiza los valores
# Docker Compose lee automáticamente este archivo

# ===========================================
# BASE DE DATOS (SUPABASE)
# ===========================================
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu_supabase_db_password_aqui
DB_HOST=tu-project-ref.supabase.co
DB_PORT=5432

# ===========================================
# REDIS (Docker Local)
# ===========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ===========================================
# DJANGO SETTINGS
# ===========================================
DEBUG=False
SECRET_KEY=tu-super-secret-key-aqui-cambia-esto-en-produccion

# ===========================================
# AWS S3 STORAGE (OPCIONAL)
# ===========================================
USE_S3=False
# AWS_ACCESS_KEY_ID=tu_access_key_id
# AWS_SECRET_ACCESS_KEY=tu_secret_access_key
# AWS_STORAGE_BUCKET_NAME=tu_bucket_name
# AWS_S3_REGION_NAME=us-east-1

# ===========================================
# SUPABASE STORAGE (ALTERNATIVA A S3)
# ===========================================
# SUPABASE_URL=https://tu-project-ref.supabase.co
# SUPABASE_ANON_KEY=tu_supabase_anon_key
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ===========================================
# DOMINIOS Y CORS
# ===========================================
ALLOWED_HOSTS=localhost,127.0.0.1,www.safe.360ingeco.com,safe.360ingeco.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://www.safe.360ingeco.com

# ===========================================
# CELERY SETTINGS
# ===========================================
CELERY_WORKER_CONCURRENCY=2
CELERY_RESULT_EXPIRES=3600
