# API Configuration for AWS Load Balancer Setup
# The Load Balancer will route traffic to backend:8000

# Backend API URL (will be behind AWS Load Balancer with /backend/ prefix)
NEXT_PUBLIC_API_URL=https://www.safe.360ingeco.com/backend
NEXT_PUBLIC_GRAPHQL_URL=https://www.safe.360ingeco.com/backend/graphql/
NEXT_PUBLIC_ADMIN_URL=https://www.safe.360ingeco.com/backend/admin/

# For internal Docker network (container-to-container communication)
NEXT_PUBLIC_INTERNAL_API_URL=http://backend:8000
NEXT_PUBLIC_INTERNAL_GRAPHQL_URL=http://backend:8000/graphql/
NEXT_PUBLIC_INTERNAL_ADMIN_URL=http://backend:8000/admin/

# App Configuration
NEXT_PUBLIC_APP_NAME=Safe 360
NEXT_PUBLIC_APP_VERSION=1.0.0

# Environment
NODE_ENV=production

# Note: When using AWS Load Balancer, update NEXT_PUBLIC_API_URL to your ALB domain
# Example: NEXT_PUBLIC_API_URL=https://your-alb-domain.com
