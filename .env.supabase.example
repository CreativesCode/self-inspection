# ===========================================
# SUPABASE — credenciales del proyecto cloud
# ===========================================
# Copia este archivo como `.env.supabase.local` y rellena los valores.
# `.env.supabase.local` está ignorado por git (patrón *.env en .gitignore).
#
# Dónde encontrarlos en el dashboard de Supabase:
#  1. Project URL + anon key + service_role key: Settings → API
#  2. Database password: la elegiste al crear el proyecto (si la perdiste,
#     Settings → Database → Reset database password)
#  3. Project ref: es el subdominio de la URL del proyecto
#     (https://<PROJECT_REF>.supabase.co)

# Identificador del proyecto (público, sale en la URL)
SUPABASE_PROJECT_REF=abcdefghijklmnop

# URL pública del proyecto (https://<PROJECT_REF>.supabase.co)
SUPABASE_URL=https://abcdefghijklmnop.supabase.co

# Anon key — clave pública que se usa en el frontend (segura para exponer)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Service role key — SECRETO, solo para scripts server-side / ETL.
# NUNCA exponer en el frontend ni hacer commit. Permite saltarse RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# Password de la base de datos (la que pusiste al crear el proyecto)
SUPABASE_DB_PASSWORD=tu_password_aqui

# Región del proyecto (informativo, debe ser eu-west-2 según decisión)
SUPABASE_REGION=eu-west-2

# Personal Access Token para el CLI (Supabase Dashboard → Account → Access Tokens)
# Permite que `supabase link`, `db push`, etc. funcionen sin abrir browser.
# Genera uno nuevo con nombre "self-inspection-cli" desde:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxx
